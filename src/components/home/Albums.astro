---
/** Homepage „Die Alben" (artboard section 4): both album cards on light. */
import Section from '../Section.astro';
import AlbumCard from '../AlbumCard.astro';
import { albums } from '../../data/albums';
import { ids, titleId } from '../../data/anchors';
import type { Locale } from '../../data/routes';
import { useT } from '../../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);
---

<Section tone="light" id={ids.albums} aria-labelledby={titleId(ids.albums)}>
  <h2 id={titleId(ids.albums)}>{t('home.albums')}</h2>
  <div class="albums">
    {albums.map((album) => <AlbumCard locale={locale} album={album} />)}
  </div>
</Section>

<style>
  .albums {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 32px;
    align-items: start;
    margin-top: 40px;
  }
</style>
