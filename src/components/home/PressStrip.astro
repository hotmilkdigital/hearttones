---
/** Homepage press line (artboard section 9): outlets as plain text (§5.10, §11), link to Presse. */
import { pressOutlets } from '../../data/press';
import { path } from '../../data/routes';
import { ids, titleId } from '../../data/anchors';
---

<section class="press" data-tone="light" aria-labelledby={titleId(ids.pressStrip)}>
  <div class="container press__inner">
    <h2 id={titleId(ids.pressStrip)} class="eyebrow press__label"><a href={path('press')}>Presse</a></h2>
    <ul class="press__list">
      {pressOutlets.map((o) => <li>{o}</li>)}
    </ul>
  </div>
</section>

<style>
  .press {
    border-top: 1px solid var(--sand);
    border-bottom: 1px solid var(--sand);
  }

  .press__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 40px;
    padding-block: 28px;
  }

  .press__label {
    margin: 0;
    font-size: 14px;
  }

  .press__label a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--ink-muted);
  }

  .press__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--ink-muted);
  }
</style>
