---
/**
 * Homepage „Produktion" (artboard section 8, paper): intro, services, CTA; references (text
 * only, no videos – they are on Über Philipp per the Seitenplan) and the Hot Milk Studio
 * partnership card with the piano photo. Studio wording per §5.7.
 */
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import pianoPhoto from '../../assets/photos/philipp-fluegel-hot-milk-studio.webp';
import { path, type Locale } from '../../data/routes';
import { productionIntro, services } from '../../data/production';
import { site } from '../../data/site';
import { works } from '../../data/works';
import { ids, titleId } from '../../data/anchors';
import { useT } from '../../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);
---

<Section tone="paper" id={ids.production} class="production" aria-labelledby={titleId(ids.production)}>
  <div class="production__grid">
    <div class="production__main">
      <h2 id={titleId(ids.production)}>{t('production.heading')}</h2>
      <p class="production__intro">{productionIntro}</p>
      <ul class="production__services">
        {services.map((s) => <li>{s}</li>)}
      </ul>
      <div class="production__actions">
        <a class="btn btn--primary" href={path('contact', locale)}>{t('production.enquire')}</a>
        <a class="btn btn--outline" href={path('production', locale)}>{t('production.more')}</a>
      </div>
    </div>

    <div class="production__side">
      <div class="production__refs">
        <h3>{t('production.references')}</h3>
        <ul>
          {
            works.map((w) => (
              <li>
                <strong>{w.artist}</strong> – {t('common.quoteOpen')}{w.title}{t('common.quoteClose')}{w.year ? ` (${w.year})` : ''}, {w.shortRole}
              </li>
            ))
          }
        </ul>
        <p class="production__refs-more"><a href={`${path('about', locale)}#${ids.works}`}>{t('production.videosAndCredits')}</a></p>
      </div>

      <div class="production__partner" data-tone="taupe">
        <Image
          src={pianoPhoto}
          alt={t('photo.pianoAlt')}
          widths={[520, 800, 1040]}
          sizes="(max-width: 760px) 100vw, 520px"
          class="production__img"
        />
        <div class="production__partner-body">
          <h3>{t('production.partnerHeading')}</h3>
          <p>
            {t('production.homePartner')}
          </p>
          <p class="production__link"><a href={site.partner.url}>hotmilkstudio.de</a></p>
          <p class="production__credit">{t('common.photo', { name: 'Robert Cummings' })}</p>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .section.production {
    border-top: 1px solid var(--sand);
  }

  .production__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }

  .production__main {
    flex: 1 1 420px;
    min-width: 0;
  }

  .production__intro {
    margin-top: 16px;
  }

  .production__services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px 24px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .production__services li {
    padding-left: 18px;
    border-left: 3px solid var(--globe-ochre);
  }

  .production__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .production__side {
    display: flex;
    flex: 1 1 360px;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .production__refs {
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--cream);
  }

  .production__refs h3,
  .production__partner h3 {
    font-size: 22px;
  }

  .production__refs ul {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .production__refs li + li {
    margin-top: 8px;
  }

  .production__refs-more,
  .production__link {
    margin-top: 8px;
    font-weight: 700;
  }

  .production__refs-more a,
  .production__link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  .production__partner {
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  .production__partner :global(.production__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .production__partner-body {
    padding: 20px 24px 24px;
  }

  .production__partner-body p {
    margin-top: 10px;
  }

  .production__credit {
    font-size: var(--fs-small);
  }
</style>
