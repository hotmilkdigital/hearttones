---
/**
 * Homepage „Neue Musik" (artboard section 5, night): Berlin Peace Collective, „Demnächst",
 * both singles as cards without credits (those are on the singles page). `ids.newMusic` is the
 * target of the hero pill. Restrictions §5.8 apply.
 */
import Section from '../Section.astro';
import SingleCard from '../SingleCard.astro';
import { path, type Locale } from '../../data/routes';
import { singles, singlesArtist } from '../../data/singles';
import { site } from '../../data/site';
import { ids, titleId } from '../../data/anchors';
import { useT } from '../../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);
---

<Section tone="night" id={ids.newMusic} aria-labelledby={titleId(ids.newMusic)}>
  <p class="badge-soon">{t('common.soon')}</p>
  <h2 id={titleId(ids.newMusic)} class="new__title">{t('newMusic.heading')}</h2>
  <p class="new__intro">
    {t('newMusic.intro', { artist: singlesArtist, fullName: site.owner.fullName })}
  </p>
  <div class="new__grid">
    {singles.map((single) => <SingleCard locale={locale} single={single} showCredits={false} />)}
  </div>
  <p class="new__more"><a href={path('singles', locale)}>{t('newMusic.more')}</a></p>
</Section>

<style>
  .new__title {
    margin-top: 10px;
  }

  .new__intro {
    max-width: 640px;
    margin-top: 12px;
    color: var(--text-muted);
  }

  .new__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 28px;
    margin-top: 40px;
  }

  .new__more {
    margin-top: 24px;
    font-weight: 700;
  }

  .new__more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }
</style>
