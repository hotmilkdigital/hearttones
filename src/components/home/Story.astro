---
/**
 * Homepage „Wie alles begann" (artboard section 7): family photo 2011 with the required credit
 * „Foto: Benedikt Stehle" (§5.11), artboard text (approved by Philipp as is, 25.10.2026),
 * link to Über Philipp.
 */
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import familyPhoto from '../../assets/photos/philipp-robert-kinder-2011.webp';
import { path, type Locale } from '../../data/routes';
import { ids, titleId } from '../../data/anchors';
import { useT } from '../../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);
---

<Section tone="light" id={ids.story} aria-labelledby={titleId(ids.story)}>
  <div class="story">
    <figure class="story__photo">
      <Image
        src={familyPhoto}
        alt={t('photo.familyAlt')}
        widths={[420, 840, 1280]}
        sizes="(max-width: 760px) 100vw, 420px"
        class="story__img"
      />
      <figcaption>{t('photo.familyAlt')} · {t('common.photo', { name: 'Benedikt Stehle' })}</figcaption>
    </figure>
    <div class="story__text">
      <p class="eyebrow story__eyebrow">{t('story.eyebrow')}</p>
      <h2 id={titleId(ids.story)}>{t('story.heading')}</h2>
      <p class="story__p">
        {t('story.p1')}
      </p>
      <p class="story__p">
        {t('story.p2')}
      </p>
      <a class="btn btn--outline story__btn" href={path('about', locale)}>{t('story.link')}</a>
    </div>
  </div>
</Section>

<style>
  .story {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .story__photo {
    flex: 1 1 320px;
    max-width: 420px;
    margin: 0;
  }

  .story__photo :global(.story__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-photo);
  }

  .story__photo figcaption {
    margin-top: 10px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .story__text {
    flex: 1 1 440px;
    min-width: 0;
  }

  .story__eyebrow {
    margin-bottom: 10px;
    color: var(--taupe);
  }

  .story__p {
    margin-top: 16px;
  }

  .story__btn {
    margin-top: 24px;
  }
</style>
