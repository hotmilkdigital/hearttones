---
/**
 * Homepage „Die Reise" teaser (artboard section 6, sand): approved intro wording (§11,
 * 24.10.2026), the build-time map as a decorative image, button to the map page.
 * „Hörprobe" only while audio can actually play.
 */
import Section from '../Section.astro';
import WorldMap from '../WorldMap.astro';
import { countries } from '../../data/countries';
import { path, type Locale } from '../../data/routes';
import { anyAudioPlayable } from '../../lib/audio';
import { ids, titleId } from '../../data/anchors';
import { useT } from '../../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);

const count = Object.keys(countries).length;
const audio = anyAudioPlayable();
---

<Section tone="sand" id={ids.journey} aria-labelledby={titleId(ids.journey)}>
  <div class="journey">
    <div class="journey__text">
      <h2 id={titleId(ids.journey)}>{t('nav.journey')}</h2>
      <p class="journey__p">
        {t('journey.intro1', { count })}
      </p>
      <p class="journey__p">
        {t('journey.intro2', { count, audio: audio ? t('journey.intro2Audio') : '' })}
      </p>
      <a class="btn btn--primary journey__btn" href={path('journey', locale)}>{t('journeyTeaser.button')}</a>
    </div>
    <div class="journey__map">
      <WorldMap locale={locale} interactive={false} label={t('journeyTeaser.mapLabel', { count })} />
    </div>
  </div>
</Section>

<style>
  .journey {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .journey__text {
    flex: 1 1 340px;
    min-width: 0;
  }

  .journey__p {
    margin-top: 16px;
  }

  .journey__btn {
    margin-top: 24px;
  }

  .journey__map {
    flex: 2 1 560px;
    min-width: 0;
  }
</style>
