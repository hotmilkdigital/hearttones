---
/**
 * Homepage „Die Reise" teaser (artboard section 6, sand): approved intro wording (§11,
 * 24.10.2026), the build-time map as a decorative image, button to the map page.
 * „Hörprobe" only while audio can actually play.
 */
import Section from '../Section.astro';
import WorldMap from '../WorldMap.astro';
import { countries } from '../../data/countries';
import { path, type Locale } from '../../data/routes';
import { anyAudioPlayable } from '../../lib/audio';
import { ids, titleId } from '../../data/anchors';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;

const count = Object.keys(countries).length;
const audio = anyAudioPlayable();
---

<Section tone="sand" id={ids.journey} aria-labelledby={titleId(ids.journey)}>
  <div class="journey">
    <div class="journey__text">
      <h2 id={titleId(ids.journey)}>Die Reise</h2>
      <p class="journey__p">
        Von Haiti bis in die Mongolei, von Dänemark bis Südafrika: Die Lieder kommen aus {count}&nbsp;Ländern – gesungen und
        gespielt von Menschen, die sie von dort mitgebracht haben.
      </p>
      <p class="journey__p">
        Auf der Karte finden Sie alle {count}&nbsp;Länder – mit Lied, Musiker:innen{audio ? ' und einer Hörprobe' : ''}.
      </p>
      <a class="btn btn--primary journey__btn" href={path('journey', locale)}>Zur Karte</a>
    </div>
    <div class="journey__map">
      <WorldMap locale={locale} interactive={false} label={`Weltkarte mit ${count} Markierungen für die Herkunftsländer der Lieder`} />
    </div>
  </div>
</Section>

<style>
  .journey {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .journey__text {
    flex: 1 1 340px;
    min-width: 0;
  }

  .journey__p {
    margin-top: 16px;
  }

  .journey__btn {
    margin-top: 24px;
  }

  .journey__map {
    flex: 2 1 560px;
    min-width: 0;
  }
</style>
