---
/**
 * Vol. 2 order by email (CLAUDE.md §10): prefilled mailto, price, shipping, payment methods,
 * delivery time, § 19 UStG note and the statutory-warranty note (pre-contractual information). Bank account and PayPal address never appear here – they go in the
 * confirmation email only (§5.14). Widerrufsbelehrung follows from Robert.
 */
import CreditList from '../CreditList.astro';
import type { Album } from '../../data/albums';
import { path, type Locale } from '../../data/routes';
import { order, site } from '../../data/site';
import { ids, titleId } from '../../data/anchors';
import { useT } from '../../i18n/t';
import { formatEur } from '../../i18n/format';

interface Props {
  locale?: Locale;
  album: Album;
}

const { locale = 'de', album } = Astro.props;
const t = useT(locale);

const eur = (value: number) => formatEur(value, locale);

const mailto = `mailto:${site.contact.email}?subject=${encodeURIComponent(order.subject)}`;

const terms = [
  { term: t('order.price'), detail: t('order.priceValue', { price: eur(order.priceEur) }) },
  {
    term: t('order.shipping'),
    detail: t('order.shippingValue', { shippingDe: eur(order.shippingDeEur), shippingIntl: eur(order.shippingIntlEur) }),
  },
  { term: t('order.delivery'), detail: t('order.deliveryValue', { de: order.deliveryDaysDe, intl: order.deliveryDaysIntl }) },
  { term: t('order.payment'), detail: t('order.paymentValue') },
];
---

<div class="order" id={ids.order}>
  <h2 id={titleId(ids.order)}>{t('order.heading')}</h2>
  <p class="order__intro">
    {t('order.intro', { shortTitle: album.shortTitle.replace(' ', ' '), fullName: site.owner.fullName })}
  </p>
  <CreditList items={terms} class="order__terms" />
  <p class="order__tax" lang={locale === 'de' ? undefined : 'de'}>{order.taxNote.replace('§ ', '§ ')}</p>
  <p class="order__warranty">{t('order.warranty')}</p>
  <div class="order__actions">
    <a class="btn btn--primary" href={mailto}>{t('album.orderByEmail')}</a>
    {
      album.links.map((l) => (
        <a class="btn btn--outline" href={l.href}>
          {l.label}
        </a>
      ))
    }
  </div>
  <p class="order__mail">
    {t('order.email')} <a href={mailto}>{site.contact.email}</a>
  </p>
  <p class="order__legal">
    <a href={path('withdrawal', locale)}>{t('order.withdrawal')}</a>
  </p>
</div>

<style>
  .order {
    max-width: 760px;
  }

  .order__intro {
    margin-top: 16px;
  }

  .order :global(.order__terms) {
    margin-top: 20px;
    --rule: var(--taupe-line);
  }

  .order__tax,
  .order__warranty {
    margin-top: 14px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .order__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .order__mail,
  .order__legal {
    margin-top: 16px;
    font-size: var(--fs-meta);
  }
</style>
