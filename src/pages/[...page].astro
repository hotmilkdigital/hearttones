---
/**
 * All DE pages except the homepage. URLs come from src/data/routes.ts only, so slugs can change
 * in one place (CLAUDE.md §4). The key → view mapping lives in PageView (shared with EN).
 */
import type { GetStaticPaths } from 'astro';
import PageView from '../views/PageView.astro';
import { routes, type PageKey, type RouteKey } from '../data/routes';

export const getStaticPaths = (() =>
  (Object.keys(routes) as RouteKey[])
    .filter((key): key is PageKey => key !== 'home')
    .map((key) => ({
      params: { page: routes[key].de.replace(/^\/|\/$/g, '') },
      props: { key },
    }))) satisfies GetStaticPaths;

const { key } = Astro.props as { key: PageKey };
---

<PageView pageKey={key} locale="de" />
