---
/**
 * Document shell (CLAUDE.md §8.1): head, meta, canonical, robots, skip link.
 * Header, Footer, OG/Twitter, hreflang and JSON-LD are added in the layout-shell and SEO steps.
 */
import '../styles/global.css';
import { site, isIndexable } from '../data/site';
import type { Locale } from '../data/routes';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
}

const { title, description, locale = 'de' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const skipLabel = locale === 'de' ? 'Zum Inhalt springen' : 'Skip to content';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!isIndexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{skipLabel}</a>
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
