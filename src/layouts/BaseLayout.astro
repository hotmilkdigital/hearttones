---
/**
 * Document shell (CLAUDE.md §8.1, §8.7): head, meta, canonical, robots, Open Graph/Twitter,
 * hreflang (only once EN is published), JSON-LD, skip link.
 * Header and Footer are added in the layout-shell step.
 */
import '../styles/global.css';
// Same hashed file as in fonts.css – preloaded because every H1 (often the LCP) is set in Literata.
import literataLatin from '@fontsource-variable/literata/files/literata-latin-opsz-normal.woff2?url';
import defaultOgImage from '../assets/og/og-default.png';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { enPublished, routes, type Locale, type RouteKey } from '../data/routes';
import { site, isIndexable, ogDefaultApproved } from '../data/site';
import { siteGraph } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Route of this page – drives hreflang alternates once EN exists. */
  routeKey?: RouteKey;
  /** Always noindex, no canonical (404). */
  noindex?: boolean;
  /** Social preview image; defaults to the site image (1200×630). */
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: 'website' | 'music.album' | 'profile';
  /** Extra JSON-LD nodes for this page (merged into the site @graph). */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  locale = 'de',
  routeKey,
  noindex = false,
  image,
  imageAlt,
  ogType = 'website',
  schema = [],
} = Astro.props;

const canonical = noindex ? null : new URL(Astro.url.pathname, site.url).href;
const skipLabel = locale === 'de' ? 'Zum Inhalt springen' : 'Skip to content';

// Social image: page image as 1200px JPEG, otherwise the default card.
const og = image
  ? await getImage({ src: image, width: 1200, format: 'jpg', quality: 85 })
  : await getImage({ src: defaultOgImage, format: 'png' });
const ogImage = new URL(og.src, site.url).href;
const ogWidth = og.attributes.width ?? (image ? 1200 : defaultOgImage.width);
const ogHeight = og.attributes.height ?? defaultOgImage.height;
const ogAlt = image
  ? (imageAlt ?? title)
  : `${site.brand} – Schlaflieder aus aller Welt: illustrierter Globus als Nachtlicht`;

const alternates =
  enPublished && routeKey && !noindex
    ? [
        { hreflang: 'de', href: new URL(routes[routeKey].de, site.url).href },
        { hreflang: 'en', href: new URL(routes[routeKey].en, site.url).href },
        { hreflang: 'x-default', href: new URL(routes[routeKey].de, site.url).href },
      ]
    : [];

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...siteGraph(), ...schema] });
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={literataLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {(noindex || !isIndexable) && <meta name="robots" content="noindex, nofollow" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={locale === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {!image && !ogDefaultApproved && <meta name="x-placeholder" content="[PLATZHALTER: OG-Bild freigeben]" />}

    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{skipLabel}</a>
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
