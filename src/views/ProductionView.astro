---
/**
 * Produktion (CLAUDE.md §1 priority 2, §5.13): services, process, references, the Hot Milk
 * Studio partnership (own section per 00_Projektstatus decision 5) and contact.
 * Never offer arrangements for school ensembles (§11). Studio wording per §5.7.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import pianoPhoto from '../assets/photos/philipp-fluegel-hot-milk-studio.webp';
import { path, type Locale } from '../data/routes';
import { mailSubjects, pricing, process, productionIntro, services } from '../data/production';
import { phoneDisplay, site } from '../data/site';
import { works } from '../data/works';
import { ids, referenceId, titleId } from '../data/anchors';
import { useT } from '../i18n/t';
import { loc } from '../i18n/localized';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);

const mailto = `mailto:${site.contact.email}?subject=${encodeURIComponent(mailSubjects.production)}`;
---

<BaseLayout
  locale={locale}
  routeKey="production"
  title={t('production.title', { brand: site.brand })}
  description={t('production.description', { fullName: site.owner.fullName })}
>
  <Section tone="light" aria-labelledby={titleId(ids.production)}>
    <Breadcrumb locale={locale} items={[{ label: t('nav.home'), href: path('home', locale) }, { label: t('nav.production') }]} />
    <h1 id={titleId(ids.production)}>{t('production.heading')}</h1>
    <p class="lead prod__intro">{loc(productionIntro, locale)}</p>
    <div class="prod__actions">
      <a class="btn btn--primary" href={mailto}>{t('production.enquireByEmail')}</a>
      <a class="btn btn--outline" href={`tel:${site.contact.phone}`}>{t('production.call', { phone: phoneDisplay(locale) })}</a>
    </div>
    <p class="prod__note">{loc(site.contact.availability, locale)}. {loc(pricing, locale)}</p>
  </Section>

  <Section tone="paper" aria-labelledby={titleId(ids.services)}>
    <div class="prod__two">
      <div>
        <h2 id={titleId(ids.services)}>{t('production.services')}</h2>
        <ul class="prod__services">
          {services.map((s) => <li>{loc(s, locale)}</li>)}
        </ul>
        <p class="prod__p">{t('production.servicesIntro')}</p>
      </div>
      <div>
        <h2 id={titleId(ids.process)}>{t('production.process')}</h2>
        <ol class="prod__steps">
          {
            process.map((step) => (
              <li>
                <span class="prod__step-title">{loc(step.title, locale)}</span>
                <span class="prod__step-text">{loc(step.text, locale)}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Section>

  <Section tone="night" aria-labelledby={titleId(ids.references)}>
    <h2 id={titleId(ids.references)}>{t('production.references')}</h2>
    <p class="prod__muted">{t('common.worksIntro')}</p>
    <div class="prod__refs">
      {
        works.map((w) => (
          <article class="prod__ref" aria-labelledby={referenceId(w.id)}>
            <h3 id={referenceId(w.id)}>{t('common.quoteOpen')}{w.title}{t('common.quoteClose')}</h3>
            <p class="prod__ref-meta">
              {w.artist} · {w.year}
            </p>
            <p class="prod__ref-credit">{loc(w.credit, locale)}</p>
            <p class="prod__ref-links">
              <a href={`${path('about', locale)}#${ids.works}`}>{t('production.watchVideo')}</a>
              <a href={w.artistLink.href}>{loc(w.artistLink.label, locale)}</a>
            </p>
          </article>
        ))
      }
    </div>
    <p class="prod__muted prod__refs-note">
      {t.split('production.albumsNote').map((s, i) =>
        i % 2 ? (
          s === 'vol1' ? <a href={path('vol1', locale)}>Lullabies From Around The World Vol.&nbsp;1</a> : <a href={path('vol2', locale)}>Vol.&nbsp;2</a>
        ) : s,
      )}
    </p>
  </Section>

  <Section tone="taupe" aria-labelledby={titleId(ids.partner)}>
    <div class="prod__partner">
      <figure class="prod__photo">
        <Image
          src={pianoPhoto}
          alt={t('photo.pianoAlt')}
          widths={[560, 1120, 1600]}
          sizes="(max-width: 760px) 100vw, 560px"
          class="prod__img"
        />
        <figcaption>{t('common.photo', { name: 'Robert Cummings' })}</figcaption>
      </figure>
      <div class="prod__partner-text">
        <h2 id={titleId(ids.partner)}>{t('production.partnerHeading')}</h2>
        <p>{t('production.partner1')}</p>
        <p>{t('production.partner2')}</p>
        <p class="prod__partner-link"><a href={site.partner.url}>hotmilkstudio.de</a></p>
      </div>
    </div>
  </Section>

  <Section tone="light" aria-labelledby={titleId(ids.enquiry)}>
    <h2 id={titleId(ids.enquiry)}>{t('production.enquire')}</h2>
    <p class="prod__p">
      {t('production.closing', { availability: loc(site.contact.availability, locale) })}
    </p>
    <div class="prod__actions">
      <a class="btn btn--primary" href={mailto}>{site.contact.email}</a>
      <a class="btn btn--outline" href={`tel:${site.contact.phone}`}>{phoneDisplay(locale)}</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .prod__intro {
    max-width: 680px;
    margin-top: 20px;
  }

  .prod__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .prod__note {
    margin-top: 16px;
    color: var(--text-muted);
  }

  .prod__two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px 64px;
  }

  .prod__services {
    display: grid;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .prod__services li {
    padding-left: 18px;
    border-left: 3px solid var(--globe-ochre);
  }

  .prod__p {
    max-width: 640px;
    margin-top: 20px;
  }

  .prod__steps {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .prod__steps li {
    position: relative;
    padding: 0 0 20px 52px;
    counter-increment: step;
  }

  .prod__steps li::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--globe-ochre);
    color: var(--cocoa);
    font-weight: 700;
  }

  .prod__step-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
  }

  .prod__step-text {
    display: block;
    color: var(--text-muted);
  }

  .prod__muted {
    margin-top: 12px;
    color: var(--text-muted);
  }

  .prod__refs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 28px;
    margin-top: 32px;
  }

  .prod__ref {
    padding: 28px;
    border: 1px solid var(--cocoa-line);
    border-radius: var(--radius-card);
    background: var(--cocoa-2);
  }

  .prod__ref-meta {
    margin-top: 4px;
    font-size: var(--fs-meta);
    color: var(--cream-faint);
  }

  .prod__ref-credit {
    margin-top: 12px;
  }

  .prod__ref-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin-top: 8px;
    font-weight: 700;
  }

  .prod__ref-links a,
  .prod__partner-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  .prod__refs-note {
    margin-top: 28px;
  }

  .prod__partner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .prod__photo {
    flex: 1 1 360px;
    min-width: 0;
    margin: 0;
  }

  .prod__photo :global(.prod__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .prod__photo figcaption {
    margin-top: 8px;
    font-size: var(--fs-small);
  }

  .prod__partner-text {
    flex: 1 1 380px;
    min-width: 0;
  }

  .prod__partner-text p {
    margin-top: 14px;
  }

  .prod__partner-link {
    font-weight: 700;
  }
</style>
