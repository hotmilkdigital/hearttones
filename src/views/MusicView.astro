---
/**
 * Musik hub (CLAUDE.md §4): both albums (AlbumCard), the Berlin Peace Collective singles kept
 * clearly separate (§5.8), and the pages that live under Musik (Künstler:innen, Presse) plus
 * Die Reise.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AlbumCard from '../components/AlbumCard.astro';
import SingleCard from '../components/SingleCard.astro';
import { albums } from '../data/albums';
import { countries } from '../data/countries';
import { path, type RouteKey, type Locale } from '../data/routes';
import { singles, singlesArtist } from '../data/singles';
import { site } from '../data/site';
import { ids, titleId } from '../data/anchors';
import { useT } from '../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);

const trackCount = albums.reduce((n, a) => n + a.tracks.length, 0);
const countryCount = Object.keys(countries).length;
const performerCount = new Set(albums.flatMap((a) => a.tracks.flatMap((t) => t.lineup.map((p) => p.person)))).size;

const more: { key: RouteKey; title: string; text: string }[] = [
  { key: 'journey', title: t('nav.journey'), text: t('music.tileJourney', { n: countryCount }) },
  { key: 'artists', title: t('nav.artists'), text: t('music.tileArtists', { n: performerCount }) },
  { key: 'press', title: t('nav.press'), text: t('music.tilePress') },
];
---

<BaseLayout
  locale={locale}
  routeKey="music"
  title={t('music.title', { brand: site.brand })}
  description={t('music.description', { brand: site.brand })}
>
  <Section tone="light" aria-labelledby={titleId(ids.music)}>
    <Breadcrumb locale={locale} items={[{ label: t('nav.home'), href: path('home', locale) }, { label: t('nav.music') }]} />
    <h1 id={titleId(ids.music)}>{t('nav.music')}</h1>
    <p class="lead music__intro">
      {t('music.lead', { artist: singlesArtist })}
    </p>
    <p class="stats music__stats">
      {t('common.stats', { tracks: trackCount, countries: countryCount, performers: performerCount })}
    </p>

    <h2 class="music__h2">Lullabies From Around The World</h2>
    <div class="music__albums">
      {albums.map((album) => <AlbumCard locale={locale} album={album} />)}
    </div>
  </Section>

  <Section tone="night" aria-labelledby={titleId(ids.singlesTeaser)}>
    <p class="badge-soon">{t('common.soon')}</p>
    <h2 id={titleId(ids.singlesTeaser)} class="music__bpc-title">{singlesArtist}</h2>
    <p class="music__bpc-intro">
      {t('music.singlesIntro', { fullName: site.owner.fullName })}
    </p>
    <div class="music__singles">
      {singles.map((single) => <SingleCard locale={locale} single={single} showCredits={false} />)}
    </div>
    <p class="music__more-link"><a href={path('singles', locale)}>{t('music.singlesLink')}</a></p>
  </Section>

  <Section tone="sand" aria-labelledby={titleId(ids.more)}>
    <h2 id={titleId(ids.more)}>{t('music.more')}</h2>
    <ul class="music__more">
      {
        more.map((m) => (
          <li>
            <a class="music__tile" href={path(m.key, locale)}>
              <span class="music__tile-title">{m.title}</span>
              <span class="music__tile-text">{m.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>

<style>
  .music__intro {
    max-width: 640px;
    margin-top: 20px;
  }

  .music__stats {
    margin-top: 16px;
  }

  .music__h2 {
    margin-top: 56px;
  }

  .music__albums,
  .music__singles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 32px;
    align-items: start;
    margin-top: 32px;
  }

  .music__bpc-title {
    margin-top: 10px;
  }

  .music__bpc-intro {
    max-width: 640px;
    margin-top: 12px;
    color: var(--text-muted);
  }

  .music__more-link {
    margin-top: 24px;
    font-weight: 700;
  }

  .music__more-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  .music__more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .music__tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 22px 24px;
    border: 1px solid var(--taupe-line);
    border-radius: var(--radius-card);
    background: var(--paper);
    color: var(--cocoa);
    text-decoration: none;
  }

  .music__tile:hover .music__tile-title {
    color: var(--heart-red);
    text-decoration: underline;
  }

  .music__tile-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
  }

  .music__tile-text {
    color: var(--ink-muted);
  }
</style>
