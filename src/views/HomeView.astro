---
/** Homepage in the order of the approved artboard (Startseite-Artboard_v6), shared by / and /en/. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import Albums from '../components/home/Albums.astro';
import NewMusic from '../components/home/NewMusic.astro';
import JourneyTeaser from '../components/home/JourneyTeaser.astro';
import Story from '../components/home/Story.astro';
import Production from '../components/home/Production.astro';
import PressStrip from '../components/home/PressStrip.astro';
import { site } from '../data/site';
import type { Locale } from '../data/routes';
import { useT } from '../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);
---

<BaseLayout
  locale={locale}
  routeKey="home"
  title={t('home.title', { brand: site.brand })}
  description={t('home.description')}
>
  <Hero locale={locale} />
  <AudioPlayer locale={locale} />
  <Albums locale={locale} />
  <NewMusic locale={locale} />
  <JourneyTeaser locale={locale} />
  <Story locale={locale} />
  <Production locale={locale} />
  <PressStrip locale={locale} />
</BaseLayout>
