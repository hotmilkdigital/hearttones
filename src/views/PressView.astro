---
/**
 * Presse (CLAUDE.md §5.10, §11 03.11.2026): all reviews of Vol. 1 from src/data/press.ts, verbatim
 * with source – press quotes, then listener voices; further press named as text only, no page
 * images, no sentence about the three-year-old son. Press contact by email.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ReviewQuote from '../components/ReviewQuote.astro';
import { pressMentions, reviews } from '../data/press';
import { mailSubjects } from '../data/production';
import { path, type Locale } from '../data/routes';
import { site } from '../data/site';
import { ids, titleId } from '../data/anchors';
import { useT } from '../i18n/t';
import { loc } from '../i18n/localized';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);

const mailto = `mailto:${site.contact.email}?subject=${encodeURIComponent(mailSubjects.press)}`;
---

<BaseLayout
  locale={locale}
  routeKey="press"
  title={t('press.title', { brand: site.brand })}
  description={t('press.description', { brand: site.brand })}
>
  <Section tone="light" aria-labelledby={titleId(ids.press)}>
    <Breadcrumb locale={locale} items={[{ label: t('nav.home'), href: path('home', locale) }, { label: t('nav.music'), href: path('music', locale) }, { label: t('nav.press') }]} />
    <h1 id={titleId(ids.press)}>{t('nav.press')}</h1>
    <p class="lead press__intro">
      {t.split('press.lead').map((s, i) => (i % 2 ? <a href={path('vol1', locale)}>{t('press.leadLink')}</a> : s))}
    </p>
  </Section>

  <Section tone="sand" aria-labelledby={titleId(ids.quotes)}>
    <h2 id={titleId(ids.quotes)}>{t('press.quotesHeading')}</h2>
    <div class="press__quotes">
      {reviews.filter((r) => r.kind === 'press').map((r) => <ReviewQuote locale={locale} review={r} detail size="large" />)}
    </div>
  </Section>

  <Section tone="paper" aria-labelledby={titleId(ids.listeners)}>
    <h2 id={titleId(ids.listeners)}>{t('press.listeners')}</h2>
    <div class="press__quotes">
      {reviews.filter((r) => r.kind === 'listener').map((r) => <ReviewQuote locale={locale} review={r} size="large" />)}
    </div>
  </Section>

  <Section tone="light" aria-labelledby={titleId(ids.mentions)}>
    <div class="press__two">
      <div>
        <h2 id={titleId(ids.mentions)}>{t('press.more')}</h2>
        <ul class="press__mentions">
          {
            pressMentions.map((m) => (
              <li>
                <strong>{m.outlet}</strong>
                {[m.what, m.date].some(Boolean) && <span> – {[m.what, m.date].flatMap((x) => (x ? [loc(x, locale)] : [])).join(', ')}</span>}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 id={titleId(ids.pressContact)}>{t('press.contact')}</h2>
        <p class="press__p">
          {t('press.contactText', { fullName: site.owner.fullName })}
        </p>
        <p class="press__actions">
          <a class="btn btn--primary" href={mailto}>{site.contact.email}</a>
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .press__intro {
    max-width: 640px;
    margin-top: 20px;
  }

  .press__quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px;
    margin-top: 28px;
  }

  .press__two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px 64px;
  }

  .press__mentions {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .press__mentions li {
    padding: 10px 0;
    border-bottom: 1px solid var(--sand);
  }

  .press__p,
  .press__actions {
    margin-top: 16px;
  }
</style>
