---
/**
 * Presse (CLAUDE.md §5.10): only the two approved short quotes, verbatim, with source
 * (placeholder until confirmed); further press named as text only, no page images, no
 * „Sitars" sentence, no sentence about the three-year-old son. Press contact by email.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Placeholder from '../components/Placeholder.astro';
import { pressMentions, pressQuotes } from '../data/press';
import { mailSubjects } from '../data/production';
import { path, type Locale } from '../data/routes';
import { site } from '../data/site';
import { ids, titleId } from '../data/anchors';
import { useT } from '../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);

const mailto = `mailto:${site.contact.email}?subject=${encodeURIComponent(mailSubjects.press)}`;
---

<BaseLayout
  locale={locale}
  routeKey="press"
  title={t('press.title', { brand: site.brand })}
  description={t('press.description', { brand: site.brand })}
>
  <Section tone="light" aria-labelledby={titleId(ids.press)}>
    <Breadcrumb locale={locale} items={[{ label: t('nav.home'), href: path('home', locale) }, { label: t('nav.music'), href: path('music', locale) }, { label: t('nav.press') }]} />
    <h1 id={titleId(ids.press)}>{t('nav.press')}</h1>
    <p class="lead press__intro">
      {t.split('press.lead').map((s, i) => (i % 2 ? <a href={path('vol1', locale)}>{t('press.leadLink')}</a> : s))}
    </p>
  </Section>

  <Section tone="sand" aria-labelledby={titleId(ids.quotes)}>
    <h2 id={titleId(ids.quotes)} class="visually-hidden">{t('press.quotesHeading')}</h2>
    <div class="press__quotes">
      {
        pressQuotes.map((q) => (
          <figure class="press__quote">
            <blockquote>
              <p>{t('common.quoteOpen')}{q.quote}{t('common.quoteClose')}</p>
            </blockquote>
            <figcaption>
              {t('common.quoteOpen')}{locale === 'de' ? q.headline : <span lang="de">{q.headline}</span>}{t('common.quoteClose')}, {q.source ?? <Placeholder text="Magazin, Ausgabe, Jahr" />} · {t('press.reviewOf')}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Section>

  <Section tone="light" aria-labelledby={titleId(ids.mentions)}>
    <div class="press__two">
      <div>
        <h2 id={titleId(ids.mentions)}>{t('press.more')}</h2>
        <ul class="press__mentions">
          {
            pressMentions.map((m) => (
              <li>
                <strong>{m.outlet}</strong>
                {[m.what, m.date].filter(Boolean).length > 0 && <span> – {[m.what, m.date].filter(Boolean).join(', ')}</span>}
              </li>
            ))
          }
        </ul>
        <p class="press__check"><Placeholder text="Belege und Links zu den Beiträgen prüfen" /></p>
      </div>
      <div>
        <h2 id={titleId(ids.pressContact)}>{t('press.contact')}</h2>
        <p class="press__p">
          {t('press.contactText', { fullName: site.owner.fullName })}
        </p>
        <p class="press__actions">
          <a class="btn btn--primary" href={mailto}>{site.contact.email}</a>
        </p>
        <p class="press__check"><Placeholder text="Pressefotos (Porträts nach dem Fotoshooting)" /></p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .press__intro {
    max-width: 640px;
    margin-top: 20px;
  }

  .press__quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px;
  }

  .press__quote {
    margin: 0;
  }

  .press__quote blockquote {
    margin: 0;
  }

  .press__quote blockquote p {
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 600;
    line-height: 1.3;
  }

  .press__quote figcaption {
    margin-top: 14px;
    font-size: var(--fs-meta);
    color: var(--text-muted);
  }

  .press__two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px 64px;
  }

  .press__mentions {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .press__mentions li {
    padding: 10px 0;
    border-bottom: 1px solid var(--sand);
  }

  .press__check,
  .press__p,
  .press__actions {
    margin-top: 16px;
  }
</style>
