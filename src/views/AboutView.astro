---
/**
 * Über Philipp von Rothkirch – structure per ../01_Brief/05_Ueber-Philipp_Seitenplan.md:
 * 1 intro + portrait placeholder, 2 the story (how Philipp and Robert met, how the lullabies
 * began, family photo), 3 instruments and way of working, 4 selected works (night, two-click
 * videos), 5 production call to action. Open texts are [PLATZHALTER] (CLAUDE.md §5.1, §12).
 * No school projects, no ensemble arrangements as a service (§11).
 */
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Placeholder from '../components/Placeholder.astro';
import ConsentVideo from '../components/ConsentVideo.astro';
import familyPhoto from '../assets/photos/philipp-robert-kinder-2011.webp';
import pianoPhoto from '../assets/photos/philipp-fluegel-hot-milk-studio.webp';
import portraitPhoto from '../assets/photos/philipp-sohn-klavier.jpg';
import { path } from '../data/routes';
import { site } from '../data/site';
import { works } from '../data/works';
import { ids, titleId, workId } from '../data/anchors';

// From Philipp's questionnaire answers (00_Projektstatus).
const instruments = ['Klavier (seit dem sechsten Lebensjahr)', 'Rhodes', 'Clavinet', 'Moog und Talkbox', 'Vibraphon', 'Bass', 'Percussion'];

/**
 * Intro portrait. Interim (§11, 25.10.2026): Philipp with his son at the upright piano, square.
 * The child is never named – not in text, alt, caption or file names. A studio portrait later
 * replaces `image` (any aspect ratio; the frame follows it); `null` shows the placeholder again.
 * `credit: null` renders „Foto: [PLATZHALTER: Fotograf:in]" (same entry in site.imageCredits).
 */
const portrait: { image: ImageMetadata; alt: string; credit: string | null } | null = {
  image: portraitPhoto,
  alt: 'Philipp von Rothkirch spielt Klavier, sein kleiner Sohn liegt auf dem Klavier und lehnt den Kopf an seine Stirn',
  credit: 'Michael von Rothkirch',
};
// Never wider than the column (340 px) or the source; 1×/2×/3× within the source's 1080 px.
const portraitWidths = portrait ? [340, 680, 1020].filter((w) => w <= portrait.image.width) : [];
---

<BaseLayout
  routeKey="about"
  ogType="profile"
  title={`${site.owner.fullName} – Komponist und Produzent | ${site.brand}`}
  description={`${site.owner.fullName}: Komponist, Produzent und Musiker in Berlin-Kreuzberg, Gründer von ${site.brand} und den Lullabies From Around The World.`}
>
  <!-- 1 Intro -->
  <Section tone="light" aria-labelledby={titleId(ids.about)}>
    <Breadcrumb items={[{ label: 'Start', href: path('home') }, { label: 'Über Philipp' }]} />
    <div class="intro">
      <div class="intro__text">
        <p class="eyebrow intro__eyebrow">Über Philipp</p>
        <h1 id={titleId(ids.about)}>{site.owner.fullName}</h1>
        <p class="lead intro__lead">Komponist, Produzent und Musiker in Berlin-Kreuzberg.</p>
        <!-- Block A, 01_Brief/08_Ueber-Philipp_Kurzbio.md (Philipp's approval pending) -->
        <p class="intro__more">
          Philipp von Rothkirch stammt aus Niedersachsen und lebt seit 2000 in Berlin. Als Keyboarder mit einer Vorliebe für
          Funk und Soul spielte er live und im Studio unter anderem für Gilbert Abdourahmane Diop, Kirk Smith, Della Miles und
          Ingrid Arthur sowie im Wintergarten Varieté Berlin. Außerdem arbeitet er als Musiktherapeut in Kitas, in
          Seniorenheimen und mit einer Gruppe von Menschen mit Trisomie 21 und unterrichtet Klavier an einer Berliner
          Musikschule.
        </p>
      </div>
      {
        portrait ? (
          <figure class="intro__portrait intro__portrait--photo">
            <Picture
              src={portrait.image}
              alt={portrait.alt}
              widths={portraitWidths}
              width={portraitWidths.at(-1)}
              sizes="(max-width: 760px) min(100vw, 340px), 340px"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading="eager"
              fetchpriority="high"
              class="intro__img"
            />
            <figcaption>Foto: {portrait.credit ?? <Placeholder text="Fotograf:in" />}</figcaption>
          </figure>
        ) : (
          <div class="intro__portrait" role="img" aria-label="Platzhalter für ein Porträt">
            <Placeholder text="Porträt Philipp von Rothkirch – Fotoshooting ausstehend" />
          </div>
        )
      }
    </div>
  </Section>

  <!-- 2 Geschichte -->
  <Section tone="paper" aria-labelledby={titleId(ids.story)}>
    <div class="story">
      <figure class="story__photo">
        <Image
          src={familyPhoto}
          alt="Philipp von Rothkirch und Robert Cummings mit ihren Kindern, 2011"
          widths={[420, 840, 1280]}
          sizes="(max-width: 760px) 100vw, 420px"
          class="story__img"
        />
        <figcaption>
          Philipp von Rothkirch und Robert Cummings mit ihren Kindern, 2011 · Foto: Benedikt Stehle
        </figcaption>
      </figure>
      <div class="story__text">
        <p class="eyebrow story__eyebrow">Wie alles begann</p>
        <h2 id={titleId(ids.story)}>Zwei Kinder, ein Tag Abstand</h2>

        <h3 class="story__sub">Wie Philipp und Robert sich kennenlernten</h3>
        <p>
          Philipp von Rothkirch wohnt in Berlin-Kreuzberg. Eine Straße weiter, in der
          Wartenburgstraße, lag von 2009 bis 2022 das Hot Milk Studio, in einer typischen Berliner Souterrainwohnung. Eines
          Tages im Jahr 2009 ging Philipp mit einem Freund einmal um den Block. Er schaute in das Souterrain und sah zu seiner
          Überraschung ein Studio. Er klopfte an die Tür und stellte sich vor. Seitdem sind Philipp und Robert Cummings
          befreundet.
        </p>

        <h3 class="story__sub">Die Idee zu den Schlafliedern</h3>
        <p>
          Die Idee zu den Schlafliedern kam mit der Geburt von Philipps Sohn. Nur einen Tag zuvor war die Tochter von Robert
          Cummings zur Welt gekommen – dem Koproduzenten, mit dem Philipp beide Alben produziert hat.
        </p>
        <p>
          Daraus wurde ein Projekt: eine Einschlaf-CD für Kinder, die auch Eltern gerne hören, und eine Reise durch die
          Vielfalt der Musik der Welt.
        </p>
        <p class="story__links">
          <a href={path('vol1')}>Vol.&nbsp;1 (2011)</a>
          <a href={path('vol2')}>Vol.&nbsp;2 (2023)</a>
          <a href={path('journey')}>Die Reise</a>
        </p>
      </div>
    </div>
  </Section>

  <!-- 3 Instrumente und Arbeitsweise -->
  <Section tone="light" aria-labelledby={titleId(ids.instruments)}>
    <div class="craft">
      <div class="craft__text">
        <h2 id={titleId(ids.instruments)}>Instrumente und Arbeitsweise</h2>
        <ul class="craft__instruments" aria-label="Instrumente">
          {instruments.map((i) => <li>{i}</li>)}
        </ul>
        <!-- Block B, 01_Brief/08 -->
        <p class="craft__p">
          Seine Lieblingsinstrumente sind Fender Rhodes, Hohner Clavinet und Moog, gern auch mit Talkbox.
        </p>
        <p class="craft__p">
          Philipp von Rothkirch komponiert schnell einen tragfähigen Basis-Song und gibt ihm prägnante Licks –
          genreübergreifend.
        </p>
        <!-- Block C, 01_Brief/08 (version 25.10.2026, 14:45) -->
        <p class="craft__p">
          Seine neuen Songs „World Peace Now!“ und „Bombs Away!“ erscheinen demnächst als{' '}
          <a href={path('singles')}>Berlin Peace Collective</a>. „Bombs Away!“ entstand 2006 mit seiner damaligen Band Phases
          of Life, als Statement gegen den Wahnsinn der Kriege weltweit; noch im selben Jahr spielte die Band den Song auf
          persönliche Einladung von Nina Hagen bei deren Peace Charity Gala. Für das Berlin Peace Collective wurde er
          teilweise neu aufgenommen und von Robert Cummings im Hot Milk Studio neu gemischt und gemastert. „World Peace Now!“
          entstand gemeinsam mit Produzent Robert Cummings im Hot Milk Studio.
        </p>
        <p class="craft__p">
          Am Anfang steht ein Erstgespräch, telefonisch oder vor Ort. Die Vorproduktion entsteht in Kreuzberg, Aufnahme und
          Postproduktion im <a href={site.partner.url}>Hot Milk Studio</a> in Berlin.
        </p>
      </div>
      <figure class="craft__photo">
        <Image
          src={pianoPhoto}
          alt="Philipp von Rothkirch am Flügel im Hot Milk Studio, Mikrofone über den Saiten"
          widths={[560, 1120, 1600]}
          sizes="(max-width: 760px) 100vw, 560px"
          class="craft__img"
        />
        <figcaption>Philipp von Rothkirch im Hot Milk Studio · Foto: Robert Cummings</figcaption>
      </figure>
    </div>
  </Section>

  <!-- 4 Ausgewählte Arbeiten -->
  <Section tone="night" id={ids.works} aria-labelledby={titleId(ids.works)}>
    <h2 id={titleId(ids.works)}>Ausgewählte Arbeiten</h2>
    <p class="works__intro">Kompositionen und Produktionen für andere Künstler:innen.</p>
    <div class="works">
      {
        works.map((w) => (
          <article class="work" aria-labelledby={`work-${w.id}`}>
            <ConsentVideo
              youtubeId={w.youtubeId}
              title={`${w.artist} – „${w.title}“`}
              posterTitle={`„${w.title}“`}
              subtitle={w.artist}
            />
            <h3 id={workId(w.id)} class="work__title">
              „{w.title}“
            </h3>
            <p class="work__meta">
              {w.artist} · {w.year ?? <Placeholder text="Jahr" />}
            </p>
            <p class="work__credit">{w.credit}</p>
            {!w.creditConfirmed && (
              <p class="work__check">
                <Placeholder text="Rollen mit Philipps vollständigen Credits abgleichen" />
              </p>
            )}
            <p class="work__artist">
              <a href={w.artistLink.href}>{w.artistLink.label}</a>
            </p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- 5 Produktion -->
  <Section tone="taupe" aria-labelledby={titleId(ids.enquiry)}>
    <div class="cta">
      <h2 id={titleId(ids.enquiry)}>Produktion anfragen</h2>
      <p class="cta__text">
        Sie singen und brauchen ein Instrumental, ein Arrangement oder eine fertige Produktion? Philipp von Rothkirch arbeitet in
        Partnerschaft mit dem Hot Milk Studio in Berlin. {site.contact.availability}.
      </p>
      <div class="cta__actions">
        <a class="btn btn--light" href={path('contact')}>Produktion anfragen</a>
        <a class="btn btn--outline" href={path('production')}>Mehr zur Produktion</a>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* 1 Intro */
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .intro__text {
    flex: 1 1 480px;
    min-width: 0;
  }

  .intro__eyebrow,
  .story__eyebrow {
    margin-bottom: 12px;
    color: var(--taupe);
  }

  .intro__lead {
    margin-top: 20px;
  }

  .intro__more {
    margin-top: 16px;
  }

  .intro__portrait {
    display: flex;
    flex: 0 1 340px;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--sand);
    text-align: center;
  }

  /* With a photo the frame follows the image's own aspect ratio (square for the interim photo). */
  .intro__portrait--photo {
    display: block;
    margin: 0;
    padding: 0;
    aspect-ratio: auto;
    background: none;
    text-align: left;
  }

  .intro__portrait--photo :global(.intro__img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-photo);
  }

  .intro__portrait--photo figcaption {
    margin-top: 10px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* 2 Geschichte */
  .story {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px;
  }

  .story__photo {
    flex: 1 1 320px;
    max-width: 420px;
    margin: 0;
  }

  .story__photo :global(.story__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-photo);
  }

  .story__photo figcaption,
  .craft__photo figcaption {
    margin-top: 10px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .story__text {
    flex: 1 1 440px;
    min-width: 0;
  }

  .story__text p {
    margin-top: 16px;
  }

  .story__sub {
    margin-top: 32px;
    font-size: 22px;
  }

  .story__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    font-weight: 700;
  }

  .story__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  /* 3 Instrumente */
  .craft {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .craft__text {
    flex: 1 1 420px;
    min-width: 0;
  }

  .craft__instruments {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px 24px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .craft__instruments li {
    padding-left: 18px;
    border-left: 3px solid var(--globe-ochre);
  }

  .craft__p {
    margin-top: 20px;
  }

  .craft__photo {
    flex: 1 1 360px;
    min-width: 0;
    margin: 0;
  }

  .craft__photo :global(.craft__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-photo);
  }

  /* 4 Arbeiten */
  .works__intro {
    margin-top: 12px;
    color: var(--text-muted);
  }

  .works {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px 32px;
    margin-top: 40px;
  }

  .work__title {
    margin-top: 20px;
  }

  .work__meta {
    margin-top: 4px;
    font-size: var(--fs-meta);
    color: var(--cream-faint);
  }

  .work__credit {
    margin-top: 12px;
  }

  .work__check {
    margin-top: 8px;
  }

  .work__artist {
    margin-top: 8px;
    font-weight: 700;
  }

  .work__artist a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  /* 5 CTA */
  .cta {
    max-width: 720px;
  }

  .cta__text {
    margin-top: 16px;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
</style>
