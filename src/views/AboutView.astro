---
/**
 * Über Philipp von Rothkirch – structure per ../01_Brief/05_Ueber-Philipp_Seitenplan.md:
 * 1 intro + portrait placeholder, 2 the story (how Philipp and Robert met, how the lullabies
 * began, family photo), 3 instruments and way of working, 4 selected works (night, two-click
 * videos), 5 production call to action. Open texts are [PLATZHALTER] (CLAUDE.md §5.1, §12).
 * No school projects, no ensemble arrangements as a service (§11).
 */
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Placeholder from '../components/Placeholder.astro';
import ConsentVideo from '../components/ConsentVideo.astro';
import familyPhoto from '../assets/photos/philipp-robert-kinder-2011.webp';
import pianoPhoto from '../assets/photos/philipp-fluegel-hot-milk-studio.webp';
import portraitPhoto from '../assets/photos/philipp-sohn-klavier.jpg';
import { path, type Locale } from '../data/routes';
import { site } from '../data/site';
import { works } from '../data/works';
import { bio, craft, instruments, met } from '../data/about';
import { loc } from '../i18n/localized';
import { ids, titleId, workId } from '../data/anchors';
import { splitSlots, useT } from '../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);
const q = (s: string) => `${t('common.quoteOpen')}${s}${t('common.quoteClose')}`;

/**
 * Intro portrait. Interim (§11, 25.10.2026): Philipp with his son at the upright piano, square.
 * The child is never named – not in text, alt, caption or file names. A studio portrait later
 * replaces `image` (any aspect ratio; the frame follows it); `null` shows the placeholder again.
 * `credit: null` renders „Foto: [PLATZHALTER: Fotograf:in]" (same entry in site.imageCredits).
 */
const portrait: { image: ImageMetadata; alt: string; credit: string | null } | null = {
  image: portraitPhoto,
  alt: t('about.portraitAlt'),
  credit: 'Michael von Rothkirch',
};
// Never wider than the column (340 px) or the source; 1×/2×/3× within the source's 1080 px.
const portraitWidths = portrait ? [340, 680, 1020].filter((w) => w <= portrait.image.width) : [];
---

<BaseLayout
  locale={locale}
  routeKey="about"
  ogType="profile"
  title={t('about.title', { fullName: site.owner.fullName, brand: site.brand })}
  description={t('about.description', { fullName: site.owner.fullName, brand: site.brand })}
>
  <!-- 1 Intro -->
  <Section tone="light" aria-labelledby={titleId(ids.about)}>
    <Breadcrumb locale={locale} items={[{ label: t('nav.home'), href: path('home', locale) }, { label: t('nav.about') }]} />
    <div class="intro">
      <div class="intro__text">
        <p class="eyebrow intro__eyebrow">{t('nav.about')}</p>
        <h1 id={titleId(ids.about)}>{site.owner.fullName}</h1>
        <p class="lead intro__lead">{t('about.lead')}</p>
        <!-- Block A, 01_Brief/08_Ueber-Philipp_Kurzbio.md (Philipp's approval pending) -->
        <p class="intro__more">
          {loc(bio, locale)}
        </p>
      </div>
      {
        portrait ? (
          <figure class="intro__portrait intro__portrait--photo">
            <Picture
              src={portrait.image}
              alt={portrait.alt}
              widths={portraitWidths}
              width={portraitWidths.at(-1)}
              sizes="(max-width: 760px) min(100vw, 340px), 340px"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading="eager"
              fetchpriority="high"
              class="intro__img"
            />
            <figcaption>{portrait.credit ? t('common.photo', { name: portrait.credit }) : <>{t('common.photo', { name: '' })}<Placeholder text="Fotograf:in" /></>}</figcaption>
          </figure>
        ) : (
          <div class="intro__portrait" role="img" aria-label={t('about.portraitPlaceholder')}>
            <Placeholder text="Porträt Philipp von Rothkirch – Fotoshooting ausstehend" />
          </div>
        )
      }
    </div>
  </Section>

  <!-- 2 Geschichte -->
  <Section tone="paper" aria-labelledby={titleId(ids.story)}>
    <div class="story">
      <figure class="story__photo">
        <Image
          src={familyPhoto}
          alt={t('photo.familyAlt')}
          widths={[420, 840, 1280]}
          sizes="(max-width: 760px) 100vw, 420px"
          class="story__img"
        />
        <figcaption>
          {t('photo.familyAlt')} · {t('common.photo', { name: 'Benedikt Stehle' })}
        </figcaption>
      </figure>
      <div class="story__text">
        <p class="eyebrow story__eyebrow">{t('story.eyebrow')}</p>
        <h2 id={titleId(ids.story)}>{t('story.heading')}</h2>

        <h3 class="story__sub">{t('about.metHeading')}</h3>
        <p>
          {loc(met, locale)}
        </p>

        <h3 class="story__sub">{t('about.ideaHeading')}</h3>
        <p>{t('story.p1')}</p>
        <p>{t('story.p2')}</p>
        <p class="story__links">
          <a href={path('vol1', locale)}>Vol.&nbsp;1 (2011)</a>
          <a href={path('vol2', locale)}>Vol.&nbsp;2 (2023)</a>
          <a href={path('journey', locale)}>{t('nav.journey')}</a>
        </p>
      </div>
    </div>
  </Section>

  <!-- 3 Instrumente und Arbeitsweise -->
  <Section tone="light" aria-labelledby={titleId(ids.instruments)}>
    <div class="craft">
      <div class="craft__text">
        <h2 id={titleId(ids.instruments)}>{t('about.instrumentsHeading')}</h2>
        <ul class="craft__instruments" aria-label={t('about.instrumentsLabel')}>
          {loc(instruments, locale).map((i) => <li>{i}</li>)}
        </ul>
        <!-- Block B, 01_Brief/08 -->
        <p class="craft__p">{loc(craft.favourites, locale)}</p>
        <p class="craft__p">{loc(craft.approach, locale)}</p>
        <!-- Block C, 01_Brief/08 (version 25.10.2026, 14:45) -->
        <p class="craft__p">
          {splitSlots(loc(craft.singles, locale)).map((s, i) => (i % 2 ? <a href={path('singles', locale)}>Berlin Peace Collective</a> : s))}
        </p>
        <p class="craft__p">
          {splitSlots(loc(craft.process, locale)).map((s, i) => (i % 2 ? <a href={site.partner.url}>Hot Milk Studio</a> : s))}
        </p>
      </div>
      <figure class="craft__photo">
        <Image
          src={pianoPhoto}
          alt={t('photo.pianoAlt')}
          widths={[560, 1120, 1600]}
          sizes="(max-width: 760px) 100vw, 560px"
          class="craft__img"
        />
        <figcaption>{t('about.pianoCaption')} · {t('common.photo', { name: 'Robert Cummings' })}</figcaption>
      </figure>
    </div>
  </Section>

  <!-- 4 Ausgewählte Arbeiten -->
  <Section tone="night" id={ids.works} aria-labelledby={titleId(ids.works)}>
    <h2 id={titleId(ids.works)}>{t('about.works')}</h2>
    <p class="works__intro">{t('common.worksIntro')}</p>
    <div class="works">
      {
        works.map((w) => (
          <article class="work" aria-labelledby={workId(w.id)}>
            <ConsentVideo locale={locale}
              youtubeId={w.youtubeId}
              title={`${w.artist} – ${q(w.title)}`}
              posterTitle={q(w.title)}
              subtitle={w.artist}
            />
            <h3 id={workId(w.id)} class="work__title">
              {t('common.quoteOpen')}{w.title}{t('common.quoteClose')}
            </h3>
            <p class="work__meta">
              {w.artist} · {w.year ?? <Placeholder text="Jahr" />}
            </p>
            <p class="work__credit">{loc(w.credit, locale)}</p>
            {!w.creditConfirmed && (
              <p class="work__check">
                <Placeholder text="Rollen mit Philipps vollständigen Credits abgleichen" />
              </p>
            )}
            <p class="work__artist">
              <a href={w.artistLink.href}>{loc(w.artistLink.label, locale)}</a>
            </p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- 5 Produktion -->
  <Section tone="taupe" aria-labelledby={titleId(ids.enquiry)}>
    <div class="cta">
      <h2 id={titleId(ids.enquiry)}>{t('production.enquire')}</h2>
      <p class="cta__text">
        {t('about.cta', { availability: loc(site.contact.availability, locale) })}
      </p>
      <div class="cta__actions">
        <a class="btn btn--light" href={path('contact', locale)}>{t('production.enquire')}</a>
        <a class="btn btn--outline" href={path('production', locale)}>{t('production.more')}</a>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* 1 Intro */
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .intro__text {
    flex: 1 1 480px;
    min-width: 0;
  }

  .intro__eyebrow,
  .story__eyebrow {
    margin-bottom: 12px;
    color: var(--taupe);
  }

  .intro__lead {
    margin-top: 20px;
  }

  .intro__more {
    margin-top: 16px;
  }

  .intro__portrait {
    display: flex;
    flex: 0 1 340px;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--sand);
    text-align: center;
  }

  /* With a photo the frame follows the image's own aspect ratio (square for the interim photo). */
  .intro__portrait--photo {
    display: block;
    margin: 0;
    padding: 0;
    aspect-ratio: auto;
    background: none;
    text-align: left;
  }

  .intro__portrait--photo :global(.intro__img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-photo);
  }

  .intro__portrait--photo figcaption {
    margin-top: 10px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* 2 Geschichte */
  .story {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px;
  }

  .story__photo {
    flex: 1 1 320px;
    max-width: 420px;
    margin: 0;
  }

  .story__photo :global(.story__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-photo);
  }

  .story__photo figcaption,
  .craft__photo figcaption {
    margin-top: 10px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .story__text {
    flex: 1 1 440px;
    min-width: 0;
  }

  .story__text p {
    margin-top: 16px;
  }

  .story__sub {
    margin-top: 32px;
    font-size: 22px;
  }

  .story__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    font-weight: 700;
  }

  .story__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  /* 3 Instrumente */
  .craft {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .craft__text {
    flex: 1 1 420px;
    min-width: 0;
  }

  .craft__instruments {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px 24px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .craft__instruments li {
    padding-left: 18px;
    border-left: 3px solid var(--globe-ochre);
  }

  .craft__p {
    margin-top: 20px;
  }

  .craft__photo {
    flex: 1 1 360px;
    min-width: 0;
    margin: 0;
  }

  .craft__photo :global(.craft__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-photo);
  }

  /* 4 Arbeiten */
  .works__intro {
    margin-top: 12px;
    color: var(--text-muted);
  }

  .works {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px 32px;
    margin-top: 40px;
  }

  .work__title {
    margin-top: 20px;
  }

  .work__meta {
    margin-top: 4px;
    font-size: var(--fs-meta);
    color: var(--cream-faint);
  }

  .work__credit {
    margin-top: 12px;
  }

  .work__check {
    margin-top: 8px;
  }

  .work__artist {
    margin-top: 8px;
    font-weight: 700;
  }

  .work__artist a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  /* 5 CTA */
  .cta {
    max-width: 720px;
  }

  .cta__text {
    margin-top: 16px;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
</style>
