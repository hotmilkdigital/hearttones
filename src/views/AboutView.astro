---
/**
 * Über Philipp v. Rothkirch – structure per ../01_Brief/05_Ueber-Philipp_Seitenplan.md:
 * 1 intro + portrait placeholder, 2 the story (how Philipp and Robert met, how the lullabies
 * began, family photo), 3 instruments and way of working, 4 selected works (night, two-click
 * videos), 5 production call to action. Open texts are [PLATZHALTER] (CLAUDE.md §5.1, §12).
 * No school projects, no ensemble arrangements as a service (§11).
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Placeholder from '../components/Placeholder.astro';
import ConsentVideo from '../components/ConsentVideo.astro';
import familyPhoto from '../assets/photos/philipp-robert-kinder-2011.webp';
import pianoPhoto from '../assets/photos/philipp-fluegel-hot-milk-studio.webp';
import { path } from '../data/routes';
import { site } from '../data/site';
import { works } from '../data/works';

// From Philipp's questionnaire answers (00_Projektstatus).
const instruments = ['Klavier (seit dem sechsten Lebensjahr)', 'Rhodes', 'Clavinet', 'Moog und Talkbox', 'Vibraphon', 'Bass', 'Percussion'];
---

<BaseLayout
  title={`${site.owner.fullName} – Komponist, Produzent und Musiker in Berlin | ${site.brand}`}
  description={`${site.owner.fullName}: Komponist, Produzent und Musiker in Berlin-Kreuzberg, Gründer von ${site.brand} und den Lullabies From Around The World.`}
>
  <!-- 1 Intro -->
  <Section tone="light" aria-labelledby="ueber-title">
    <Breadcrumb items={[{ label: 'Start', href: path('home') }, { label: 'Über Philipp' }]} />
    <div class="intro">
      <div class="intro__text">
        <p class="eyebrow intro__eyebrow">Über Philipp</p>
        <h1 id="ueber-title">{site.owner.fullName}</h1>
        <p class="lead intro__lead">Komponist, Produzent und Musiker in Berlin-Kreuzberg.</p>
        <p class="intro__more">
          <Placeholder text="Drei Sätze über Philipp (B10) – Entwurf von Robert, Freigabe Philipp" />
        </p>
      </div>
      <div class="intro__portrait" role="img" aria-label="Platzhalter für ein Porträt">
        <Placeholder text="Porträt Philipp v. Rothkirch – Fotoshooting ausstehend" />
      </div>
    </div>
  </Section>

  <!-- 2 Geschichte -->
  <Section tone="paper" aria-labelledby="geschichte-title">
    <div class="story">
      <figure class="story__photo">
        <Image
          src={familyPhoto}
          alt="Philipp v. Rothkirch und Robert Cummings mit ihren Kindern, 2011"
          widths={[420, 840, 1280]}
          sizes="(max-width: 760px) 100vw, 420px"
          class="story__img"
        />
        <figcaption>
          Philipp v. Rothkirch und Robert Cummings mit ihren Kindern, 2011 · Foto: Benedikt Stehle
        </figcaption>
      </figure>
      <div class="story__text">
        <p class="eyebrow story__eyebrow">Wie alles begann</p>
        <h2 id="geschichte-title">Zwei Kinder, ein Tag Abstand</h2>

        <h3 class="story__sub">Wie Philipp und Robert sich kennenlernten</h3>
        <p>
          Philipp von Rothkirch wohnt in Berlin-Kreuzberg. Eine Straße weiter, in der
          Wartenburgstraße, lag von 2009 bis 2022 das Hot Milk Studio, in einer typischen Berliner Souterrainwohnung. Eines
          Tages im Jahr 2009 ging Philipp mit einem Freund einmal um den Block. Er schaute in das Souterrain und sah zu seiner
          Überraschung ein Studio. Er klopfte an die Tür und stellte sich vor. Seitdem sind Philipp und Robert Cummings
          befreundet.
        </p>

        <h3 class="story__sub">Die Idee zu den Schlafliedern</h3>
        <p>
          Die Idee zu den Schlafliedern kam mit der Geburt von Philipps Sohn. Nur einen Tag zuvor war die Tochter von Robert
          Cummings zur Welt gekommen – dem Toningenieur, mit dem Philipp beide Alben produziert hat.
        </p>
        <p>
          Daraus wurde ein Projekt: eine Einschlaf-CD für Kinder, die auch Eltern gerne hören, und eine Reise durch die
          Vielfalt der Musik der Welt.
        </p>
        <p><Placeholder text="Fortsetzung von Philipps Vol.-1-Geschichte („Somit hatten wir beide …“)" /></p>
        <p class="story__links">
          <a href={path('vol1')}>Vol.&nbsp;1 (2011)</a>
          <a href={path('vol2')}>Vol.&nbsp;2 (2023)</a>
          <a href={path('journey')}>Die Reise</a>
        </p>
      </div>
    </div>
  </Section>

  <!-- 3 Instrumente und Arbeitsweise -->
  <Section tone="light" aria-labelledby="instrumente-title">
    <div class="craft">
      <div class="craft__text">
        <h2 id="instrumente-title">Instrumente und Arbeitsweise</h2>
        <ul class="craft__instruments" aria-label="Instrumente">
          {instruments.map((i) => <li>{i}</li>)}
        </ul>
        <p class="craft__p">
          Philipp v. Rothkirch komponiert schnell einen tragfähigen Basis-Song und gibt ihm prägnante Licks –
          genreübergreifend.
        </p>
        <p class="craft__p">
          Am Anfang steht ein Erstgespräch, telefonisch oder vor Ort. Die Vorproduktion entsteht in Kreuzberg, Aufnahme und
          Postproduktion im <a href={site.partner.url}>Hot Milk Studio</a> in Berlin.
        </p>
      </div>
      <figure class="craft__photo">
        <Image
          src={pianoPhoto}
          alt="Philipp v. Rothkirch am Flügel im Hot Milk Studio, Mikrofone über den Saiten"
          widths={[560, 1120, 1600]}
          sizes="(max-width: 760px) 100vw, 560px"
          class="craft__img"
        />
        <figcaption>Philipp v. Rothkirch im Hot Milk Studio · Foto: Robert Cummings</figcaption>
      </figure>
    </div>
  </Section>

  <!-- 4 Ausgewählte Arbeiten -->
  <Section tone="night" aria-labelledby="arbeiten-title">
    <h2 id="arbeiten-title">Ausgewählte Arbeiten</h2>
    <p class="works__intro">Kompositionen und Produktionen für andere Künstler:innen.</p>
    <div class="works">
      {
        works.map((w) => (
          <article class="work" aria-labelledby={`work-${w.id}`}>
            <ConsentVideo
              youtubeId={w.youtubeId}
              title={`${w.artist} – „${w.title}“`}
              posterTitle={`„${w.title}“`}
              subtitle={w.artist}
            />
            <h3 id={`work-${w.id}`} class="work__title">
              „{w.title}“
            </h3>
            <p class="work__meta">
              {w.artist} · {w.year ?? <Placeholder text="Jahr" />}
            </p>
            <p class="work__credit">{w.credit}</p>
            {!w.creditConfirmed && (
              <p class="work__check">
                <Placeholder text="Rollen mit Philipps vollständigen Credits abgleichen" />
              </p>
            )}
            <p class="work__artist">
              <a href={w.artistLink.href}>{w.artistLink.label}</a>
            </p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- 5 Produktion -->
  <Section tone="taupe" aria-labelledby="produktion-cta-title">
    <div class="cta">
      <h2 id="produktion-cta-title">Produktion anfragen</h2>
      <p class="cta__text">
        Sie singen und brauchen ein Instrumental, ein Arrangement oder eine fertige Produktion? Philipp v. Rothkirch arbeitet in
        Partnerschaft mit dem Hot Milk Studio in Berlin. {site.contact.availability}.
      </p>
      <div class="cta__actions">
        <a class="btn btn--light" href={path('contact')}>Produktion anfragen</a>
        <a class="btn btn--outline" href={path('production')}>Mehr zur Produktion</a>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* 1 Intro */
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .intro__text {
    flex: 1 1 480px;
    min-width: 0;
  }

  .intro__eyebrow,
  .story__eyebrow {
    margin-bottom: 12px;
    color: var(--taupe);
  }

  .intro__lead {
    margin-top: 20px;
  }

  .intro__more {
    margin-top: 16px;
  }

  .intro__portrait {
    display: flex;
    flex: 0 1 340px;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--sand);
    text-align: center;
  }

  /* 2 Geschichte */
  .story {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px;
  }

  .story__photo {
    flex: 1 1 320px;
    max-width: 420px;
    margin: 0;
  }

  .story__photo :global(.story__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-photo);
  }

  .story__photo figcaption,
  .craft__photo figcaption {
    margin-top: 10px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .story__text {
    flex: 1 1 440px;
    min-width: 0;
  }

  .story__text p {
    margin-top: 16px;
  }

  .story__sub {
    margin-top: 32px;
    font-size: 22px;
  }

  .story__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    font-weight: 700;
  }

  .story__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  /* 3 Instrumente */
  .craft {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }

  .craft__text {
    flex: 1 1 420px;
    min-width: 0;
  }

  .craft__instruments {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px 24px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .craft__instruments li {
    padding-left: 18px;
    border-left: 3px solid var(--globe-ochre);
  }

  .craft__p {
    margin-top: 20px;
  }

  .craft__photo {
    flex: 1 1 360px;
    min-width: 0;
    margin: 0;
  }

  .craft__photo :global(.craft__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-photo);
  }

  /* 4 Arbeiten */
  .works__intro {
    margin-top: 12px;
    color: var(--text-muted);
  }

  .works {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px 32px;
    margin-top: 40px;
  }

  .work__title {
    margin-top: 20px;
  }

  .work__meta {
    margin-top: 4px;
    font-size: var(--fs-meta);
    color: var(--cream-faint);
  }

  .work__credit {
    margin-top: 12px;
  }

  .work__check {
    margin-top: 8px;
  }

  .work__artist {
    margin-top: 8px;
    font-weight: 700;
  }

  .work__artist a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  /* 5 CTA */
  .cta {
    max-width: 720px;
  }

  .cta__text {
    margin-top: 16px;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
</style>
