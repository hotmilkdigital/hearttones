---
/**
 * Album page for Vol. 1 and Vol. 2 (CLAUDE.md §8.3): cover, facts, intro, status/links,
 * track list with full credits (shared player), performers, production credits.
 * Vol. 1: out of print + streaming links + press quote. Vol. 2: order block + funding notice.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { clearedCover } from '../lib/covers';
import { albumGraph } from '../lib/schema';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Cover from '../components/Cover.astro';
import CreditList from '../components/CreditList.astro';
import Placeholder from '../components/Placeholder.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import FundingNotice from '../components/FundingNotice.astro';
import OrderBlock from '../components/album/OrderBlock.astro';
import { albumDuration, albumPerformers, formatDuration, type Album, type Credit } from '../data/albums';
import { people, type Person } from '../data/people';
import { pressQuotes } from '../data/press';
import { roleLabel } from '../data/roles';
import { path } from '../data/routes';
import { site } from '../data/site';

interface Props {
  album: Album;
}

const { album } = Astro.props;

const nb = (s: string) => s.replace(/(Vol\.|HTR|LC-?|Nr\.) /g, '$1 ');
const seriesTitle = 'Lullabies From Around The World';
const countryCount = new Set(album.tracks.map((t) => t.countries[0])).size;
const performers = albumPerformers(album);
const released = new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' }).format(new Date(album.releaseDate));

const facts = [
  { term: 'Künstler', detail: album.artist },
  { term: 'Label', detail: album.label },
  { term: 'Katalognummer', detail: nb(album.catalogueNo) },
  { term: 'Labelcode', detail: album.labelCode },
  { term: 'Erschienen', detail: released },
  { term: 'Spielzeit', detail: `${formatDuration(albumDuration(album))} · ${album.tracks.length} Lieder · ${countryCount} Länder` },
];

const trackRef = (nos: number[]) =>
  nos.map((n) => `Nr. ${n} („${album.tracks.find((t) => t.no === n)?.title}“)`).join(', ');

const creditItem = (c: Credit) => ({
  term: c.tracks ? `${roleLabel(c.role)} ${trackRef(c.tracks)}` : roleLabel(c.role),
  detail: c.exceptTracks
    ? `${c.names.join(', ')} (außer Nr. ${c.exceptTracks.join(', ')})`
    : c.names.join(', '),
});

// Own website (domain as link text) and year of death from people.ts (§5.16).
const performerItems = performers.map((p) => {
  const person: Person = people[p.id];
  return {
    term: p.name,
    termNote: person.diedYear ? `verstorben ${person.diedYear}` : undefined,
    detail: [p.roles.map((r) => roleLabel(r)).join(', '), `Nr. ${p.tracks.join(', ')}`].filter(Boolean).join(' · '),
    link: person.website
      ? { href: person.website, text: new URL(person.website).hostname.replace(/^www\./, '') }
      : undefined,
  };
});

const quote = album.id === 'vol-1' ? pressQuotes.find((q) => q.id === 'schlaf-mein-kind') : undefined;

// Social image and schema image: the cover only when it is cleared for this build (§9).
const coverImage = clearedCover(album);
const ogCover = coverImage ? await getImage({ src: coverImage, width: 1200, format: 'jpg', quality: 85 }) : null;

const pageTitle = `${seriesTitle} ${album.shortTitle} (${album.year}) – ${site.brand}`;
const description = `${site.brand} ${album.shortTitle}: ${album.tracks.length} Schlaflieder aus ${countryCount} Ländern mit ${performers.length} Musiker:innen. Titelliste, Mitwirkende und ${album.status === 'outOfPrint' ? 'Streaming-Links' : 'Bestellung der CD'}.`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  routeKey={album.id === 'vol-1' ? 'vol1' : 'vol2'}
  ogType="music.album"
  image={coverImage ?? undefined}
  imageAlt={album.coverAlt}
  schema={albumGraph(album, ogCover ? new URL(ogCover.src, site.url).href : undefined)}
>
  <Section tone="light" class="album-head" aria-labelledby="album-title">
    <Breadcrumb
      items={[
        { label: 'Start', href: path('home') },
        { label: 'Musik', href: path('music') },
        { label: nb(album.shortTitle) },
      ]}
    />
    <div class="album-head__grid">
      <div class="album-head__text">
        <p class="eyebrow album-head__eyebrow">{site.brand} · Album · {album.year}</p>
        <h1 id="album-title">
          {seriesTitle} <span class="album-head__vol">{nb(album.shortTitle)}</span>
        </h1>
        <p class="lead album-head__intro">{album.teaser}</p>
        {album.story?.map((p) => <p class="album-head__more">{nb(p)}</p>)}

        {
          album.status === 'outOfPrint' ? (
            <div class="album-head__status">
              <p class="album-head__status-text">CD vergriffen – als Stream erhältlich</p>
              <div class="album-head__actions">
                {album.links.map((l) => (
                  <a class="btn btn--outline" href={l.href}>
                    {l.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <div class="album-head__status">
              <div class="album-head__actions">
                <a class="btn btn--primary" href="#bestellen">
                  CD per E-Mail bestellen
                </a>
                {album.links.map((l) => (
                  <a class="btn btn--outline" href={l.href}>
                    {l.label}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <p class="album-head__studio">
          Zum größten Teil aufgenommen sowie gemischt und gemastert im <a href={site.partner.url}>Hot Milk Studio</a> Berlin.
        </p>
      </div>

      <div class="album-head__aside">
        <Cover album={album} width={420} sizes="(max-width: 760px) 100vw, 420px" shadow="light" loading="eager" />
        <CreditList items={facts} class="album-head__facts" />
      </div>
    </div>
  </Section>

  <AudioPlayer albumIds={[album.id]} id="lieder" heading="Die Lieder" showWriting showAside={false} />

  <Section tone="paper" aria-labelledby="mitwirkende-title">
    <div class="people">
      <div>
        <h2 id="mitwirkende-title">Mitwirkende</h2>
        <p class="people__intro">
          {performers.length} Musiker:innen und Ensembles.
        </p>
        <CreditList items={performerItems} class="people__list" />
        <p class="people__more"><a href={path('artists')}>Alle Künstler:innen beider Alben</a></p>
      </div>
      <div>
        <h2 id="produktion-title">Produktion und Gestaltung</h2>
        <CreditList items={album.credits.map(creditItem)} class="people__list" />
        {album.thanks && <p class="people__thanks">{album.thanks}</p>}
      </div>
    </div>
  </Section>

  {
    quote && (
      <Section tone="sand" aria-label="Presse">
        <figure class="quote">
          <blockquote>
            <p>„{quote.quote}“</p>
          </blockquote>
          <figcaption>
            „{quote.headline}“,{' '}
            {quote.source ?? <Placeholder text="Magazin, Ausgabe, Jahr" />} ·{' '}
            <a href={path('press')}>Presse</a>
          </figcaption>
        </figure>
      </Section>
    )
  }

  {
    album.status === 'available' && (
      <>
        <Section tone="sand" aria-labelledby="bestellen-title">
          <OrderBlock album={album} />
        </Section>
        <Section tone="light" aria-label="Förderung">
          <FundingNotice />
        </Section>
      </>
    )
  }
</BaseLayout>

<style>
  .album-head__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }

  .album-head__text {
    flex: 1 1 480px;
    min-width: 0;
  }

  .album-head__aside {
    flex: 0 1 420px;
    min-width: 0;
  }

  .album-head__eyebrow {
    margin-bottom: 12px;
    color: var(--taupe);
  }

  .album-head__vol {
    white-space: nowrap;
  }

  .album-head__intro {
    max-width: 560px;
    margin-top: 24px;
  }

  .album-head__more {
    margin-top: 16px;
  }

  .album-head__status {
    margin-top: 32px;
  }

  .album-head__status-text {
    font-weight: 700;
  }

  .album-head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }

  .album-head__studio {
    max-width: 560px;
    margin-top: 28px;
    color: var(--text-muted);
  }

  .album-head__aside :global(.album-head__facts) {
    margin-top: 28px;
    font-size: var(--fs-meta);
  }

  .people {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px 64px;
  }

  .people__intro {
    margin-top: 12px;
    color: var(--text-muted);
  }

  .people :global(.people__list) {
    margin-top: 20px;
    font-size: var(--fs-meta);
  }

  /* Thanks line below the production credits – same size and colour as the credit details. */
  .people__thanks {
    margin-top: 16px;
    font-size: var(--fs-meta);
    color: var(--text-muted);
  }

  .people__more {
    margin-top: 20px;
    font-weight: 700;
  }

  .people__more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  .quote {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    font-family: var(--font-serif);
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 600;
    line-height: 1.3;
  }

  .quote figcaption {
    margin-top: 16px;
    font-size: var(--fs-meta);
    color: var(--text-muted);
  }
</style>
