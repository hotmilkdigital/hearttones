---
/**
 * Stub page until the real page is built (P7 hub, P10). Correct title, description and
 * breadcrumb; the body is a visible [PLATZHALTER] plus links to what already exists, so no
 * internal link ends in the 404.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Placeholder from '../components/Placeholder.astro';
import { path, type RouteKey } from '../data/routes';

interface Props {
  routeKey: RouteKey;
  title: string;
  description: string;
  heading: string;
  /** What will be on this page. */
  placeholder: string;
  /** Parent in the breadcrumb (Künstler:innen and Presse live under Musik). */
  parent?: { label: string; key: RouteKey };
  /** Existing pages worth linking to meanwhile. */
  links?: { label: string; key: RouteKey }[];
}

const { routeKey, title, description, heading, placeholder, parent, links = [] } = Astro.props;
---

<BaseLayout title={title} description={description} routeKey={routeKey}>
  <Section tone="light" aria-labelledby="stub-title">
    <Breadcrumb
      items={[
        { label: 'Start', href: path('home') },
        ...(parent ? [{ label: parent.label, href: path(parent.key) }] : []),
        { label: heading },
      ]}
    />
    <h1 id="stub-title">{heading}</h1>
    <p class="stub__body"><Placeholder text={placeholder} /></p>
    {
      links.length > 0 && (
        <ul class="stub__links">
          {links.map((l) => (
            <li>
              <a class="btn btn--outline" href={path(l.key)}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Section>
</BaseLayout>

<style>
  .stub__body {
    max-width: 680px;
    margin-top: 20px;
  }

  .stub__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
</style>
