---
/**
 * Berlin Peace Collective page (CLAUDE.md §8.4): both unreleased singles as cards with credits,
 * clearly separate from the lullabies. No player, artwork or date until released (§5.8).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SingleCard from '../components/SingleCard.astro';
import { path, type Locale } from '../data/routes';
import { singles, singlesArtist } from '../data/singles';
import { site } from '../data/site';
import { ids, titleId } from '../data/anchors';
import { useT } from '../i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);
---

<BaseLayout
  locale={locale}
  routeKey="singles"
  title={t('singles.title', { artist: singlesArtist, brand: site.brand })}
  description={t('singles.description', { artist: singlesArtist, fullName: site.owner.fullName })}
>
  <Section tone="light" aria-labelledby={titleId(ids.singles)}>
    <Breadcrumb locale={locale}
      items={[{ label: t('nav.home'), href: path('home', locale) }, { label: t('nav.music'), href: path('music', locale) }, { label: singlesArtist }]}
    />
    <p class="badge-soon">{t('common.soon')}</p>
    <h1 id={titleId(ids.singles)} class="singles__title">{singlesArtist}</h1>
    <p class="lead singles__intro">
      {t('newMusic.intro', { artist: singlesArtist, fullName: site.owner.fullName })}
    </p>
  </Section>

  <Section tone="night" aria-label={t('singles.label')}>
    <div class="singles__grid">
      {singles.map((single) => <SingleCard locale={locale} single={single} headingLevel="h2" />)}
    </div>
  </Section>
</BaseLayout>

<style>
  .singles__title {
    margin-top: 16px;
  }

  .singles__intro {
    max-width: 640px;
    margin-top: 20px;
  }

  .singles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 28px;
    align-items: start;
  }
</style>
