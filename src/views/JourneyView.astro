---
/**
 * Die Reise (CLAUDE.md §8.5): intro, build-time world map, and below it the same
 * information as an accessible list grouped by continent – the list is the content.
 * Two-country credits: listed under the first-named country, the second is named in the
 * entry and cross-referenced under that country.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WorldMap from '../components/WorldMap.astro';
import { formatDuration, lineupText, type Album } from '../data/albums';
import {
  continentLabels,
  countries,
  countryName,
  tracksForCountry,
  type Continent,
  type CountryCode,
} from '../data/countries';
import { path, type Locale } from '../data/routes';
import { site } from '../data/site';
import { anyAudioPlayable } from '../lib/audio';
import { teamPins } from '../data/team-pins';
import { continentId, countryId, ids, titleId, trackId } from '../data/anchors';
import { useT } from '../i18n/t';
import { compareText } from '../i18n/format';
import { loc } from '../i18n/localized';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useT(locale);

const countryCount = Object.keys(countries).length;
const continentOrder: Continent[] = ['africa', 'americas', 'asia', 'europe', 'oceania'];

const albumUrl = (album: Album) => path(album.id === 'vol-1' ? 'vol1' : 'vol2', locale);
const trackUrl = (album: Album, track: Album['tracks'][number]) => `${albumUrl(album)}#${trackId(album.id, track.no)}`;
const nb = (s: string) => s.replace('Vol. ', 'Vol. ');

const groups = continentOrder.map((continent) => {
  const codes = (Object.keys(countries) as CountryCode[])
    .filter((code) => countries[code].continent === continent)
    .sort((a, b) => compareText(locale)(countryName(a, locale), countryName(b, locale)));
  return {
    continent,
    label: continentLabels[continent][locale],
    countries: codes.map((code) => {
      const refs = tracksForCountry(code);
      return {
        code,
        name: countryName(code, locale),
        primary: refs.filter((r) => r.primary),
        secondary: refs.filter((r) => !r.primary),
      };
    }),
  };
});

const audio = anyAudioPlayable();
---

<BaseLayout
  locale={locale}
  routeKey="journey"
  title={t('journey.title', { n: countryCount, brand: site.brand })}
  description={t('journey.description', { n: countryCount })}
>
  <Section tone="light" aria-labelledby={titleId(ids.journey)}>
    <Breadcrumb locale={locale} items={[{ label: t('nav.home'), href: path('home', locale) }, { label: t('nav.journey') }]} />
    <h1 id={titleId(ids.journey)}>{t('nav.journey')}</h1>
    <div class="reise__intro">
      <p class="lead">
        {t('journey.intro1', { count: countryCount })}
      </p>
      <p>
        {t('journey.intro2', { count: countryCount, audio: audio ? t('journey.intro2Audio') : '' })}
      </p>
    </div>
  </Section>

  <Section tone="night" class="reise__map-section" aria-labelledby={titleId(ids.map)}>
    <h2 id={titleId(ids.map)} class="visually-hidden">{t('journey.mapHeading')}</h2>
    <WorldMap locale={locale} />
    <p class="reise__map-note">
      {t('journey.mapNote')}
    </p>
  </Section>

  <Section tone="light" id={ids.countries} aria-labelledby={titleId(ids.countries)} tabindex="-1">
    <h2 id={titleId(ids.countries)}>{t('journey.allCountries', { n: countryCount })}</h2>
    {
      groups.map((group) => (
        <section class="continent" aria-labelledby={continentId(group.continent)}>
          <h3 id={continentId(group.continent)} class="continent__title">
            {group.label} <span class="continent__count">({group.countries.length})</span>
          </h3>
          <div class="continent__grid">
            {group.countries.map((c) => (
              <article class="country" id={countryId(c.code)} aria-labelledby={titleId(countryId(c.code))} tabindex="-1">
                <h4 id={titleId(countryId(c.code))} class="country__name">
                  {c.name}
                </h4>
                <ul class="country__songs">
                  {c.primary.map(({ album, track }) => (
                    <li>
                      <a class="country__song" href={trackUrl(album, track)}>
                        {t('common.quoteOpen')}<span lang={track.lang}>{track.title}</span>
                        {track.titleAlt && (
                          <>
                            {' / '}
                            <span lang={track.titleAltLang}>{track.titleAlt}</span>
                          </>
                        )}
                        {t('common.quoteClose')}
                      </a>
                      <span class="country__meta">
                        {nb(album.shortTitle)} · {t('common.no', { n: track.no })} · {formatDuration(track.durationSec)}
                        {track.countries.length > 1 && <> · {track.countries.map((cc) => countryName(cc, locale)).join(' / ')}</>}
                      </span>
                      <span class="country__lineup">{lineupText(track, locale)}</span>
                    </li>
                  ))}
                </ul>
                {c.secondary.length > 0 && (
                  <p class="country__also">
                    {t('journey.also')}{' '}
                    {c.secondary.map(({ album, track }, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={trackUrl(album, track)}>{t('common.quoteOpen')}{track.title}{t('common.quoteClose')}</a> ({track.countries.map((cc) => countryName(cc, locale)).join(' / ')}, {nb(album.shortTitle)})
                      </>
                    ))}
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <section class="continent" aria-labelledby={titleId(ids.team)}>
      <h3 id={titleId(ids.team)} class="continent__title">{t('journey.team')}</h3>
      <div class="continent__grid">
        {
          teamPins.map((t) => (
            <article class="country country--team" id={countryId(t.id)} aria-labelledby={titleId(countryId(t.id))} tabindex="-1">
              <h4 id={titleId(countryId(t.id))} class="country__name">
                {t.place} ({loc(t.country, locale)})
              </h4>
              <p class="country__team-name">{t.name}</p>
              <span class="country__meta">{loc(t.note, locale)}</span>
              <span class="country__lineup">{loc(t.roles, locale)}</span>
              <a class="country__song" href={t.link.href}>
                {t.link.label}
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </Section>
</BaseLayout>

<style>
  .reise__intro {
    max-width: 680px;
    margin-top: 20px;
  }

  .reise__intro p + p {
    margin-top: 16px;
  }

  .reise__map-note {
    max-width: 680px;
    margin-top: 16px;
    font-size: var(--fs-meta);
    color: var(--text-muted);
  }

  .continent {
    margin-top: 48px;
  }

  .continent__title {
    padding-bottom: 12px;
    border-bottom: 2px solid var(--sand);
  }

  .continent__count {
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    font-weight: 600;
    color: var(--text-muted);
  }

  .continent__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .country {
    padding: 20px 22px;
    border: 1px solid var(--sand);
    border-radius: var(--radius-card);
    background: var(--paper);
    scroll-margin-top: 24px;
  }

  .country:target,
  .country:focus {
    outline: 3px solid var(--heart-red);
    outline-offset: 3px;
  }

  .country__name {
    font-size: 22px;
  }

  .country__team-name {
    margin-top: 10px;
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
  }

  .country--team .country__lineup {
    margin-top: 6px;
  }

  .country__songs {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .country__songs li + li {
    margin-top: 14px;
  }

  .country__song {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
  }

  .country__meta,
  .country__lineup {
    display: block;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .country__lineup {
    margin-top: 2px;
  }

  .country__also {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid var(--sand);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* ids.countries in anchors.ts – CSS cannot import it */
  #countries:focus {
    outline: none;
  }
</style>
