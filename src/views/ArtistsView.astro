---
/**
 * Künstler:innen: all 46 performers and ensembles of both albums (CLAUDE.md §5.4), sorted by
 * name, with roles and songs (linked to the track on its album page). Names without links
 * until Philipp's research table is back (§8.3, §12); no photos without consent.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Placeholder from '../components/Placeholder.astro';
import { albums, trackAnchor, type Album, type Track } from '../data/albums';
import { countryName } from '../data/countries';
import { people, type PersonId } from '../data/people';
import { roleLabel, type Role } from '../data/roles';
import { path } from '../data/routes';
import { site } from '../data/site';

interface Entry {
  id: PersonId;
  roles: Role[];
  songs: { album: Album; track: Track }[];
}

const byId = new Map<PersonId, Entry>();
for (const album of albums) {
  for (const track of album.tracks) {
    for (const p of track.lineup) {
      const e = byId.get(p.person) ?? { id: p.person, roles: [], songs: [] };
      for (const r of p.roles) if (!e.roles.includes(r)) e.roles.push(r);
      e.songs.push({ album, track });
      byId.set(p.person, e);
    }
  }
}

const entries = [...byId.values()].sort((a, b) => people[a.id].name.localeCompare(people[b.id].name, 'de'));
const albumUrl = (album: Album) => path(album.id === 'vol-1' ? 'vol1' : 'vol2');
const nb = (s: string) => s.replace('Vol. ', 'Vol. ');
---

<BaseLayout
  routeKey="artists"
  title={`Künstler:innen der Lullabies From Around The World | ${site.brand}`}
  description={`Die ${entries.length} Musiker:innen und Ensembles auf Lullabies From Around The World Vol. 1 und Vol. 2 – mit Liedern, Instrumenten und Ländern.`}
>
  <Section tone="light" aria-labelledby="kuenstler-title">
    <Breadcrumb items={[{ label: 'Start', href: path('home') }, { label: 'Musik', href: path('music') }, { label: 'Künstler:innen' }]} />
    <h1 id="kuenstler-title">Künstler:innen</h1>
    <p class="lead artists__intro">
      {entries.length}&nbsp;Musiker:innen und Ensembles haben die Lieder auf <a href={path('vol1')}>Vol.&nbsp;1</a> und{' '}
      <a href={path('vol2')}>Vol.&nbsp;2</a> gesungen und gespielt.
    </p>
    <p class="artists__note"><Placeholder text="aktuelle Links und Fotos der Musiker:innen (Recherche Philipp)" /></p>

    <ul class="artists" aria-label="Alle Musiker:innen und Ensembles">
      {
        entries.map((e) => {
          const person = people[e.id];
          return (
            <li class="artist">
              <h2 class="artist__name">{person.name}</h2>
              {'alsoCredited' in person && person.alsoCredited && (
                <p class="artist__aka">auch: {person.alsoCredited}</p>
              )}
              <p class="artist__roles">
                {person.kind === 'ensemble' && <span class="artist__tag">Ensemble</span>}
                {e.roles.map((r) => roleLabel(r)).join(', ')}
              </p>
              <ul class="artist__songs">
                {e.songs.map(({ album, track }) => (
                  <li>
                    <a href={`${albumUrl(album)}#${trackAnchor(album, track)}`}>
                      „<span lang={track.lang}>{track.title}</span>“
                    </a>{' '}
                    <span class="artist__meta">
                      {nb(album.shortTitle)} · {track.countries.map((c) => countryName(c)).join(' / ')}
                    </span>
                  </li>
                ))}
              </ul>
              {e.id === 'philipp-v-rothkirch' && (
                <p class="artist__more">
                  <a href={path('about')}>Mehr über Philipp von Rothkirch</a>
                </p>
              )}
            </li>
          );
        })
      }
    </ul>
  </Section>
</BaseLayout>

<style>
  .artists__intro {
    max-width: 680px;
    margin-top: 20px;
  }

  .artists__note {
    margin-top: 16px;
  }

  .artists {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }

  .artist {
    padding: 20px 22px;
    border: 1px solid var(--sand);
    border-radius: var(--radius-card);
    background: var(--paper);
  }

  .artist__name {
    font-size: 21px;
  }

  .artist__more {
    margin-top: 6px;
    font-weight: 700;
  }

  .artist__more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }

  .artist__aka {
    margin-top: 2px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .artist__roles {
    margin-top: 6px;
    font-size: var(--fs-meta);
    color: var(--text-muted);
  }

  .artist__tag {
    display: inline-block;
    margin-right: 8px;
    padding: 0 8px;
    border-radius: var(--radius-pill);
    background: var(--sand);
    color: var(--cocoa);
    font-size: 13px;
    font-weight: 700;
  }

  .artist__songs {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .artist__songs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-family: var(--font-serif);
    font-weight: 600;
  }

  .artist__meta {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>
